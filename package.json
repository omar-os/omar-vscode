{
  "name": "omar-vscode",
  "displayName": "OMAR",
  "description": "OMAR language support and Mission Control: syntax highlighting, compilation, and live observation of running deployments.",
  "version": "0.2.0",
  "license": "BSD-3-Clause",
  "publisher": "omar-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/omar-os/omar-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "omar",
    "agents",
    "mission control",
    "topology",
    "orchestration"
  ],
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "omar",
        "aliases": [
          "OMAR",
          "omar"
        ],
        "extensions": [
          ".omar"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "omar",
        "scopeName": "source.omar",
        "path": "./syntaxes/omar.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "omar.compile",
        "title": "OMAR: Compile to bytecode",
        "icon": "$(gear)"
      },
      {
        "command": "omar.showDiagram",
        "title": "OMAR: Show topology diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "omar.connect",
        "title": "OMAR: Connect to Runtime",
        "icon": "$(plug)"
      },
      {
        "command": "omar.disconnect",
        "title": "OMAR: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "omar.refresh",
        "title": "OMAR: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "omar.selectDeployment",
        "title": "OMAR: Select Deployment",
        "icon": "$(list-selection)"
      },
      {
        "command": "omar.inspect",
        "title": "OMAR: Inspect"
      },
      {
        "command": "omar.showMenu",
        "title": "OMAR: Mission Control Menu"
      },
      {
        "command": "omar.openMissionControl",
        "title": "OMAR: Open Mission Control",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "omar.revealArtifacts",
        "title": "OMAR: Reveal Deployment Files",
        "icon": "$(folder-opened)"
      },
      {
        "command": "omar.showOnTopology",
        "title": "OMAR: Show on Topology",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "omar.clearHighlight",
        "title": "OMAR: Clear Topology Highlight",
        "icon": "$(clear-all)"
      },
      {
        "command": "omar.openEvidence",
        "title": "OMAR: Open Evidence",
        "icon": "$(go-to-file)"
      },
      {
        "command": "omar.connectDiagram",
        "title": "OMAR: Follow a Diagram Server (Read Only)",
        "icon": "$(eye)"
      },
      {
        "command": "omar.runProgram",
        "title": "OMAR: Run Program",
        "icon": "$(play)"
      },
      {
        "command": "omar.stopDeployment",
        "title": "OMAR: Stop Deployment",
        "icon": "$(debug-stop)"
      },
      {
        "command": "omar.startRuntime",
        "title": "OMAR: Start Runtime",
        "icon": "$(play)"
      },
      {
        "command": "omar.stopRuntime",
        "title": "OMAR: Stop Runtime"
      },
      {
        "command": "omar.showRuntimeLog",
        "title": "OMAR: Show Runtime Log",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "omar.showDiagram",
          "when": "resourceLangId == omar",
          "group": "navigation"
        },
        {
          "command": "omar.runProgram",
          "when": "resourceLangId == omar && omar.canRun",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "omar.openMissionControl",
          "when": "view == omar.deployments",
          "group": "navigation@0"
        },
        {
          "command": "omar.refresh",
          "when": "view == omar.deployments && omar.reach != 'disconnected'",
          "group": "navigation@1"
        },
        {
          "command": "omar.connect",
          "when": "view == omar.deployments",
          "group": "navigation@2"
        },
        {
          "command": "omar.disconnect",
          "when": "view == omar.deployments && omar.reach != 'disconnected'",
          "group": "navigation@3"
        },
        {
          "command": "omar.revealArtifacts",
          "when": "view == omar.artifacts && omar.hasSelection",
          "group": "navigation"
        },
        {
          "command": "omar.clearHighlight",
          "when": "view == omar.guarantees",
          "group": "navigation"
        },
        {
          "command": "omar.stopDeployment",
          "when": "view == omar.summary && omar.canStop",
          "group": "navigation@1"
        },
        {
          "command": "omar.runProgram",
          "when": "view == omar.deployments && omar.canRun",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "omar.inspect",
          "when": "false"
        },
        {
          "command": "omar.showMenu",
          "when": "false"
        },
        {
          "command": "omar.showOnTopology",
          "when": "false"
        },
        {
          "command": "omar.openEvidence",
          "when": "false"
        },
        {
          "command": "omar.stopDeployment",
          "when": "omar.canStop"
        },
        {
          "command": "omar.runProgram",
          "when": "omar.canRun"
        }
      ],
      "view/item/context": [
        {
          "command": "omar.showOnTopology",
          "when": "view == omar.guarantees && viewItem =~ /^guarantee/",
          "group": "inline@1"
        },
        {
          "command": "omar.openEvidence",
          "when": "view == omar.guarantees && viewItem == guarantee.evidence",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "OMAR",
      "properties": {
        "omar.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7340",
          "description": "Address of `omar serve`, the daemon Mission Control reads deployments from."
        },
        "omar.autoStartRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Start `omar serve` when nothing answers at a loopback `omar.runtimeUrl`. The daemon runs as a child of the extension and stops with it; a daemon that was already running is left alone."
        },
        "omar.serveArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--no-ea"
          ],
          "description": "Extra arguments for the `omar serve` the extension starts. `--no-ea` leaves the executive assistant, which Mission Control here has no chat for, unstarted."
        },
        "omar.dataDir": {
          "type": "string",
          "default": "~/.omar",
          "description": "The runtime's data directory on the machine VS Code's extension host runs on (the remote, under Remote SSH). Artifacts are read from `<dataDir>/ea/<ea>/topologies/<team>/`."
        },
        "omar.cliPath": {
          "type": "string",
          "default": "omar",
          "description": "Path to the omar binary, used to stop a deployment, and to start the runtime when none is running. Resolved on PATH when it is a bare name."
        },
        "omar.compilerPath": {
          "type": "string",
          "default": "omarc",
          "description": "Path to the omarc binary. Resolved on PATH when it is a bare name."
        },
        "omar.diagramServerUrl": {
          "type": "string",
          "default": "",
          "description": "Address of a running diagram server, for example http://127.0.0.1:7341. When set, the diagram follows the run rather than showing the compiled topology alone."
        },
        "omar.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile a .omar file when it is saved, to report errors as diagnostics."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omar",
          "title": "OMAR",
          "icon": "media/omar.svg"
        }
      ]
    },
    "views": {
      "omar": [
        {
          "id": "omar.deployments",
          "name": "Deployments",
          "icon": "media/omar.svg",
          "contextualTitle": "OMAR"
        },
        {
          "id": "omar.summary",
          "name": "Deployment",
          "icon": "media/omar.svg"
        },
        {
          "id": "omar.teams",
          "name": "Teams",
          "icon": "media/omar.svg"
        },
        {
          "id": "omar.inspector",
          "name": "Inspector",
          "icon": "media/omar.svg"
        },
        {
          "id": "omar.artifacts",
          "name": "Artifacts",
          "icon": "media/omar.svg"
        },
        {
          "id": "omar.guarantees",
          "name": "Guarantees",
          "icon": "media/omar.svg"
        },
        {
          "id": "omar.events",
          "name": "Events",
          "icon": "media/omar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "omar.deployments",
        "contents": "Not connected to an OMAR runtime.\n[Connect](command:omar.connect)",
        "when": "omar.reach == 'disconnected'"
      },
      {
        "view": "omar.deployments",
        "contents": "Connecting\u2026",
        "when": "omar.reach == 'connecting'"
      },
      {
        "view": "omar.deployments",
        "contents": "Starting the runtime\u2026\n[Show runtime log](command:omar.showRuntimeLog)",
        "when": "omar.reach == 'starting'"
      },
      {
        "view": "omar.deployments",
        "contents": "Nothing is answering at `omar.runtimeUrl`, and the runtime could not be started here.\n[Start runtime](command:omar.startRuntime)\n[Show runtime log](command:omar.showRuntimeLog)\n[Change address](command:omar.connect)",
        "when": "omar.reach == 'unreachable'"
      },
      {
        "view": "omar.deployments",
        "contents": "Connected. The runtime has no deployments yet; it lists the runs it has started since it came up.",
        "when": "omar.reach == 'connected'"
      },
      {
        "view": "omar.summary",
        "contents": "No deployment selected.",
        "when": "!omar.hasSelection"
      },
      {
        "view": "omar.teams",
        "contents": "No deployment selected.",
        "when": "!omar.hasSelection"
      },
      {
        "view": "omar.inspector",
        "contents": "Click an agent, reaction, port or team in the topology or the Teams view to inspect it.",
        "when": "!omar.inspecting"
      },
      {
        "view": "omar.artifacts",
        "contents": "No deployment selected.",
        "when": "!omar.hasSelection"
      },
      {
        "view": "omar.guarantees",
        "contents": "No deployment selected.",
        "when": "!omar.hasSelection"
      },
      {
        "view": "omar.events",
        "contents": "No deployment selected.",
        "when": "!omar.hasSelection"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.webview.json && node build/webview.mjs",
    "watch": "tsc -p . --watch",
    "lint": "eslint src test webview build",
    "test": "npm run build && node --test test/*.test.mjs",
    "vscode:prepublish": "npm run build",
    "test:vscode": "npm run build && node test/vscode/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^2.5.2",
    "elkjs": "^0.12.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.66.0"
  }
}
